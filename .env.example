# Copy to .env and fill in only the keys you want to use. .env is git-ignored; never commit real keys.
# All keys are optional: `reel-studio demo` and `--voice-provider none` work without any.
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=

# Optional settings
# REEL_STUDIO_PROJECTS=/path/to/projects     # where projects are created (default: ./projects)
# REEL_STUDIO_GL=angle                       # Chromium GL backend for rendering (default: angle; swangle on Linux)
# REEL_STUDIO_CINETIC=/path/to/cinetic       # cinetic skill folder for `reel-studio score`
